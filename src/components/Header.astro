---
import { site, withBase } from '@data/site';

const pathname = Astro.url.pathname;
const links = [
  { href: '/', label: 'Home' },
  { href: '/services/', label: 'Services' },
  { href: '/portfolio/', label: 'Portfolio' },
  { href: '/contact/', label: 'Contact' }
];

function isCurrent(href: string) {
  const full = withBase(href);
  if (href === '/') return pathname === full || pathname === `${full}/`;
  return pathname.startsWith(full);
}
---

<a class="skip-link" href="#main-content">Skip to content</a>
<header class="site-header">
  <div class="header-inner">
    <a class="brand" href={withBase('/')} aria-label="Red Rock Remodeling home">
      <img src={withBase(site.logoPath)} alt="Red Rock Remodeling" width="220" height="78" />
    </a>
    <nav class="primary-nav" aria-label="Primary navigation">
      {
        links.map((link) => (
          <a href={withBase(link.href)} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
    </nav>
    <a class="phone-link" href={site.phoneHref}>Call {site.phoneDisplay}</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgb(222 216 208 / 0.9);
    background: rgb(252 250 247 / 0.96);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    display: flex;
    width: min(100%, var(--max-page));
    margin-inline: auto;
    padding: 0.75rem var(--space-4);
    gap: var(--space-3);
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    flex: 0 0 auto;
  }

  .brand img {
    width: min(220px, 42vw);
    height: auto;
  }

  .primary-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.85rem;
    align-items: center;
    justify-content: center;
  }

  .primary-nav a,
  .phone-link {
    color: var(--color-ink);
    font-size: var(--step--1);
    font-weight: 800;
    text-decoration: none;
  }

  .primary-nav a {
    padding: 0.35rem 0;
  }

  .primary-nav a[aria-current='page'] {
    color: var(--color-red-rock);
    box-shadow: inset 0 -2px 0 var(--color-red-rock);
  }

  .phone-link {
    display: inline-flex;
    min-height: 44px;
    padding: 0.55rem 0.75rem;
    border: 2px solid var(--color-red-rock);
    border-radius: var(--radius);
    color: var(--color-red-rock);
    align-items: center;
    justify-content: center;
    white-space: nowrap;
  }

  .phone-link:hover {
    background: var(--color-red-rock);
    color: var(--color-white);
  }

  @media (max-width: 760px) {
    .site-header {
      position: static;
    }

    .header-inner {
      flex-wrap: wrap;
      padding-block: 0.6rem;
    }

    .brand img {
      width: min(150px, 38vw);
    }

    .phone-link {
      order: 2;
      padding: 0.45rem 0.6rem;
      font-size: 0.88rem;
    }

    .primary-nav {
      order: 3;
      flex-basis: 100%;
      justify-content: flex-start;
      gap: 0.25rem 1.1rem;
      padding-top: 0.25rem;
      border-top: 1px solid rgb(222 216 208 / 0.9);
    }
  }
</style>
