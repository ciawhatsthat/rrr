---
/**
 * Real photo, optimized by Astro's <Image>. Reserves aspect ratio (no layout shift),
 * generates responsive widths, lazy by default. Pass `priority` for the hero.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  aspect?: string; // e.g. "4 / 3"; omit to use the photo's own ratio
  sizes?: string;
  priority?: boolean;
  caption?: string;
  class?: string;
}

const {
  src,
  alt,
  aspect,
  sizes = '(min-width: 1200px) 560px, (min-width: 760px) 50vw, 100vw',
  priority = false,
  caption
} = Astro.props;
const className = Astro.props.class ?? '';
const style = aspect ? `--photo-aspect: ${aspect};` : `--photo-aspect: ${src.width} / ${src.height};`;
---

<figure class:list={['photo', className]} style={style}>
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1200, 1600]}
    sizes={sizes}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    decoding="async"
    quality={78}
  />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .photo {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: var(--photo-aspect);
    background: var(--color-soft);
  }
  .photo img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .photo figcaption {
    padding: 0.5rem 0.1rem 0;
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: 1.4;
  }
</style>
