---
import { absoluteUrl, site } from '@data/site';

// Web3Forms when a key is set; plain mailto: fallback otherwise.
const live = Boolean(site.formAccessKey);
const action = live ? 'https://api.web3forms.com/submit' : `mailto:${site.email}`;
---

<form
  class="contact-form"
  action={action}
  method="post"
  enctype={live ? undefined : 'text/plain'}
>
  {
    live && (
      <>
        <input type="hidden" name="access_key" value={site.formAccessKey} />
        <input type="hidden" name="subject" value="New flooring inquiry from red-rock-remodeling.net" />
        <input type="hidden" name="from_name" value="Red Rock website" />
        <input type="hidden" name="redirect" value={absoluteUrl('/thanks/')} />
        {/* honeypot: real people never see or fill this */}
        <input type="checkbox" name="botcheck" class="botcheck" tabindex="-1" autocomplete="off" aria-hidden="true" />
      </>
    )
  }
  <div class="field">
    <label for="name">Name</label>
    <input id="name" name="name" type="text" autocomplete="name" required />
  </div>
  <div class="field">
    <label for="email">Email</label>
    <input id="email" name="email" type="email" autocomplete="email" required />
  </div>
  <div class="field">
    <label for="phone">Phone</label>
    <input id="phone" name="phone" type="tel" autocomplete="tel" />
  </div>
  <div class="field">
    <label for="project-type">Project type</label>
    <select id="project-type" name="project_type">
      <option value="">Select a project type</option>
      <option>Hardwood</option>
      <option>Luxury vinyl plank</option>
      <option>Tile</option>
      <option>Carpet</option>
      <option>Stairs</option>
      <option>Subfloor repair</option>
      <option>Other flooring project</option>
    </select>
  </div>
  <div class="field field-full">
    <label for="message">Message</label>
    <textarea id="message" name="message" rows="7" required></textarea>
  </div>
  <button class="button field-full" type="submit">Send project details</button>
  <p class="field-full fine-print">
    Or just call or text <a href={site.phoneHref}>{site.phoneDisplay}</a>. Andrew answers his own phone.
  </p>
</form>

<style>
  .contact-form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
  }

  .field {
    display: grid;
    gap: 0.35rem;
  }

  .field-full {
    grid-column: 1 / -1;
  }

  label {
    color: var(--color-ink);
    font-weight: 800;
  }

  input,
  select,
  textarea {
    width: 100%;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-ink);
    padding: 0.75rem 0.8rem;
  }

  textarea {
    resize: vertical;
  }

  button {
    justify-self: start;
    cursor: pointer;
  }

  .botcheck {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .fine-print {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--step--1);
  }

  @media (max-width: 640px) {
    .contact-form {
      grid-template-columns: 1fr;
    }
  }
</style>
