---
import PhotoPlaceholder from '@components/PhotoPlaceholder.astro';
import type { PortfolioCategory, PortfolioItem } from '@data/portfolio';

interface Props {
  items: PortfolioItem[];
  categories: PortfolioCategory[];
}

const { items, categories } = Astro.props;
---

<section class="portfolio-tool" aria-label="Flooring portfolio gallery">
  <div class="filters" aria-label="Portfolio filters">
    <button type="button" class="filter-button is-active" data-filter="All" aria-pressed="true">All</button>
    {
      categories.map((category) => (
        <button type="button" class="filter-button" data-filter={category} aria-pressed="false">
          {category}
        </button>
      ))
    }
  </div>

  <div class="portfolio-grid" data-portfolio-grid>
    {
      items.map((item) => (
        <button
          type="button"
          class="portfolio-card"
          data-category={item.category}
          data-title={item.title}
          data-caption={item.caption}
          data-replace={item['data-replace']}
          data-alt={item.alt}
        >
          <PhotoPlaceholder
            label={item.category}
            detail={item.title}
            data-replace={item['data-replace']}
            alt={item.alt}
            aspect={item.aspect ?? '4 / 3'}
          />
          <span class="portfolio-card-copy">
            <strong>{item.title}</strong>
            <small>{item.caption}</small>
          </span>
        </button>
      ))
    }
  </div>

  <dialog class="portfolio-dialog" data-portfolio-dialog>
    <button type="button" class="dialog-close" data-dialog-close aria-label="Close portfolio preview">Close</button>
    <figure class="dialog-placeholder" data-dialog-placeholder role="img" aria-label="">
      <div class="dialog-placeholder-content">
        <span data-dialog-title></span>
        <small data-dialog-replace></small>
      </div>
    </figure>
    <p data-dialog-caption></p>
  </dialog>
</section>

<script is:inline>
  const grid = document.querySelector('[data-portfolio-grid]');
  const dialog = document.querySelector('[data-portfolio-dialog]');

  if (grid && dialog) {
    const filterButtons = document.querySelectorAll('[data-filter]');
    const cards = grid.querySelectorAll('[data-category]');
    const closeButton = dialog.querySelector('[data-dialog-close]');
    const title = dialog.querySelector('[data-dialog-title]');
    const replace = dialog.querySelector('[data-dialog-replace]');
    const caption = dialog.querySelector('[data-dialog-caption]');
    const placeholder = dialog.querySelector('[data-dialog-placeholder]');

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');

        filterButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });

        cards.forEach((card) => {
          const visible = filter === 'All' || card.getAttribute('data-category') === filter;
          card.hidden = !visible;
        });
      });
    });

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        if (title) title.textContent = card.getAttribute('data-title') || '';
        if (replace) replace.textContent = card.getAttribute('data-replace') || '';
        if (caption) caption.textContent = card.getAttribute('data-caption') || '';
        if (placeholder) placeholder.setAttribute('aria-label', card.getAttribute('data-alt') || '');
        if ('showModal' in dialog) {
          dialog.showModal();
        }
      });
    });

    closeButton?.addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });
  }
</script>

<style>
  .portfolio-tool {
    display: grid;
    gap: var(--space-4);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .filter-button {
    min-height: 42px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-ink);
    cursor: pointer;
    font-weight: 800;
    padding: 0.45rem 0.75rem;
  }

  .filter-button.is-active,
  .filter-button:hover {
    border-color: var(--color-red-rock);
    background: var(--color-red-rock);
    color: var(--color-white);
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: var(--space-4);
  }

  .portfolio-card {
    display: grid;
    gap: var(--space-3);
    width: 100%;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    color: inherit;
    cursor: pointer;
    overflow: hidden;
    text-align: left;
  }

  .portfolio-card:hover {
    border-color: rgb(168 40 34 / 0.5);
    box-shadow: var(--shadow-soft);
  }

  .portfolio-card :global(.photo-placeholder) {
    border: 0;
    border-radius: 0;
  }

  .portfolio-card-copy {
    display: grid;
    gap: 0.2rem;
    padding: 0 var(--space-3) var(--space-3);
  }

  .portfolio-card-copy strong {
    font-size: var(--step-0);
  }

  .portfolio-card-copy small {
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: 1.35;
  }

  .portfolio-dialog {
    width: min(94vw, 840px);
    border: 0;
    border-radius: var(--radius);
    background: var(--color-paper);
    padding: var(--space-4);
  }

  .portfolio-dialog::backdrop {
    background: rgb(34 32 29 / 0.72);
  }

  .dialog-close {
    display: inline-flex;
    min-height: 40px;
    margin: 0 0 var(--space-3) auto;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-ink);
    cursor: pointer;
    font-weight: 800;
    padding: 0.4rem 0.7rem;
  }

  .dialog-placeholder {
    display: grid;
    margin: 0;
    min-height: 320px;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    aspect-ratio: 16 / 10;
    background:
      linear-gradient(135deg, rgb(168 40 34 / 0.08), transparent 42%),
      repeating-linear-gradient(
        -45deg,
        var(--color-soft),
        var(--color-soft) 10px,
        #ebe4dc 10px,
        #ebe4dc 20px
      );
    place-items: center;
  }

  .dialog-placeholder-content {
    display: grid;
    gap: 0.3rem;
    max-width: 76%;
    text-align: center;
  }

  .dialog-placeholder-content span {
    color: var(--color-ink);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .dialog-placeholder-content small,
  .portfolio-dialog p {
    color: var(--color-muted);
  }

  .portfolio-dialog p {
    margin: var(--space-3) 0 0;
  }
</style>
