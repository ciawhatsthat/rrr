---
/**
 * Filterable photo grid built from the projects collection (plus any extra service photos).
 * Vanilla JS filter + native <dialog> lightbox. The lightbox shows the same optimized image
 * the card rendered (reads the <img> src), so no extra image processing.
 */
import type { ImageMetadata } from 'astro';
import Photo from '@components/Photo.astro';

export interface GridItem {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  category: string; // display label, e.g. "LVP"
  project?: string; // project title
  projectId?: string;
}

interface Props {
  items: GridItem[];
  categories: string[];
}

const { items, categories } = Astro.props;
---

<section class="portfolio-tool" aria-label="Flooring photo gallery">
  <div class="filters" role="group" aria-label="Filter photos by category">
    <button type="button" class="filter-button is-active" data-filter="All" aria-pressed="true">All</button>
    {
      categories.map((category) => (
        <button type="button" class="filter-button" data-filter={category} aria-pressed="false">
          {category}
        </button>
      ))
    }
  </div>

  <div class="portfolio-grid" data-portfolio-grid>
    {
      items.map((item) => (
        <button
          type="button"
          class="portfolio-card"
          data-category={item.category}
          data-caption={item.caption ?? ''}
          data-project={item.project ?? ''}
          data-alt={item.alt}
        >
          <Photo src={item.src} alt={item.alt} aspect="4 / 3" sizes="(min-width: 1200px) 280px, (min-width: 760px) 33vw, 50vw" />
          <span class="portfolio-card-copy">
            <strong>{item.project ?? item.category}</strong>
            {item.caption && <small>{item.caption}</small>}
          </span>
        </button>
      ))
    }
  </div>

  <dialog class="portfolio-dialog" data-portfolio-dialog>
    <button type="button" class="dialog-close" data-dialog-close aria-label="Close photo">Close</button>
    <img class="dialog-image" data-dialog-image alt="" />
    <p class="dialog-caption"><strong data-dialog-project></strong> <span data-dialog-caption></span></p>
  </dialog>
</section>

<script is:inline>
  (() => {
    const grid = document.querySelector('[data-portfolio-grid]');
    const dialog = document.querySelector('[data-portfolio-dialog]');
    if (!grid || !dialog) return;
    const filterButtons = document.querySelectorAll('[data-filter]');
    const cards = grid.querySelectorAll('[data-category]');
    const dImg = dialog.querySelector('[data-dialog-image]');
    const dProject = dialog.querySelector('[data-dialog-project]');
    const dCaption = dialog.querySelector('[data-dialog-caption]');

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.getAttribute('data-filter');
        filterButtons.forEach((b) => {
          const active = b === button;
          b.classList.toggle('is-active', active);
          b.setAttribute('aria-pressed', String(active));
        });
        cards.forEach((card) => {
          card.hidden = !(filter === 'All' || card.getAttribute('data-category') === filter);
        });
      });
    });

    cards.forEach((card) => {
      card.addEventListener('click', () => {
        const img = card.querySelector('img');
        if (!img) return;
        dImg.src = img.currentSrc || img.src;
        dImg.alt = card.getAttribute('data-alt') || '';
        dProject.textContent = card.getAttribute('data-project') || '';
        dCaption.textContent = card.getAttribute('data-caption') || '';
        if ('showModal' in dialog) dialog.showModal();
      });
    });

    dialog.querySelector('[data-dialog-close]').addEventListener('click', () => dialog.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
  })();
</script>

<style>
  .portfolio-tool {
    display: grid;
    gap: var(--space-4);
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .filter-button {
    min-height: 42px;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-ink);
    cursor: pointer;
    font-weight: 800;
  }
  .filter-button.is-active,
  .filter-button:hover {
    border-color: var(--color-red-rock);
    background: var(--color-red-rock);
    color: var(--color-white);
  }
  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: var(--space-4);
  }
  .portfolio-card {
    display: grid;
    gap: var(--space-2);
    width: 100%;
    padding: 0;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
    color: inherit;
    cursor: zoom-in;
    overflow: hidden;
    text-align: left;
    font: inherit;
  }
  .portfolio-card:hover {
    border-color: rgb(168 40 34 / 0.5);
    box-shadow: var(--shadow-soft);
  }
  .portfolio-card :global(.photo) {
    border-radius: 0;
  }
  .portfolio-card-copy {
    display: grid;
    gap: 0.15rem;
    padding: 0 var(--space-3) var(--space-3);
  }
  .portfolio-card-copy strong {
    font-size: var(--step--1);
  }
  .portfolio-card-copy small {
    color: var(--color-muted);
    font-size: var(--step--1);
    line-height: 1.35;
  }
  .portfolio-dialog {
    width: min(96vw, 1000px);
    padding: var(--space-3);
    border: 0;
    border-radius: var(--radius);
    background: var(--color-ink);
    color: var(--color-white);
  }
  .portfolio-dialog::backdrop {
    background: rgb(0 0 0 / 0.8);
  }
  .dialog-close {
    display: inline-flex;
    min-height: 40px;
    margin: 0 0 var(--space-2) auto;
    padding: 0.4rem 0.7rem;
    border: 0;
    border-radius: var(--radius);
    background: var(--color-white);
    color: var(--color-ink);
    cursor: pointer;
    font-weight: 800;
  }
  .dialog-image {
    display: block;
    max-width: 100%;
    max-height: 78vh;
    width: auto;
    height: auto;
    margin: 0 auto;
    border-radius: 4px;
  }
  .dialog-caption {
    margin: var(--space-2) 0 0;
    text-align: center;
    color: rgb(255 255 255 / 0.85);
  }
</style>
