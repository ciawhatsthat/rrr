---
import type { ImageMetadata } from 'astro';
import { withBase } from '@data/site';
import Photo from '@components/Photo.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  image: ImageMetadata;
  alt: string;
}

const { title, description, href, image, alt } = Astro.props;
---

<article class="service-card">
  <Photo src={image} alt={alt} aspect="4 / 3" sizes="(min-width: 1200px) 360px, (min-width: 760px) 33vw, 100vw" />
  <div class="service-card-body">
    <h3><a href={withBase(href)}>{title}</a></h3>
    <p>{description}</p>
    <a class="learn-more" href={withBase(href)}>Learn more about {title}</a>
  </div>
</article>

<style>
  .service-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
  }

  .service-card :global(.photo) {
    border-bottom: 1px solid var(--color-line);
    border-radius: 0;
  }

  .service-card-body {
    display: grid;
    padding: var(--space-4);
    gap: var(--space-2);
  }

  h3 {
    margin: 0;
    font-size: var(--step-2);
  }

  h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--color-red-rock);
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }

  .learn-more {
    align-self: end;
    font-weight: 800;
  }
</style>
