---
import PhotoPlaceholder from '@components/PhotoPlaceholder.astro';

interface Props {
  title: string;
  description: string;
  href: string;
  'data-replace': string;
  alt: string;
}

const { title, description, href, alt } = Astro.props;
const dataReplace = Astro.props['data-replace'];
---

<article class="service-card">
  <PhotoPlaceholder
    label={title}
    detail="Service photo placeholder"
    data-replace={dataReplace}
    alt={alt}
    aspect="4 / 3"
  />
  <div class="service-card-body">
    <h3><a href={href}>{title}</a></h3>
    <p>{description}</p>
    <a class="learn-more" href={href}>Learn more about {title}</a>
  </div>
</article>

<style>
  .service-card {
    display: grid;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
  }

  .service-card :global(.photo-placeholder) {
    border: 0;
    border-bottom: 1px solid var(--color-line);
    border-radius: 0;
  }

  .service-card-body {
    display: grid;
    padding: var(--space-4);
    gap: var(--space-2);
  }

  h3 {
    margin: 0;
    font-size: var(--step-2);
  }

  h3 a {
    color: var(--color-ink);
    text-decoration: none;
  }

  h3 a:hover {
    color: var(--color-red-rock);
  }

  p {
    margin: 0;
    color: var(--color-muted);
  }

  .learn-more {
    align-self: end;
    font-weight: 800;
  }
</style>
