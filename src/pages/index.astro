---
import { getCollection } from 'astro:content';
import Layout from '@components/Layout.astro';
import Photo from '@components/Photo.astro';
import ProjectStory from '@components/ProjectStory.astro';
import ServiceCard from '@components/ServiceCard.astro';
import { site, withBase } from '@data/site';
import heroPhoto from '@assets/photos/hero-herringbone-lvp.jpg';
import aboutPhoto from '@assets/photos/about-andrew-trevor.jpg';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const featured = ['aurora-basement-lvp', 'bathroom-subfloor']
  .map((id) => projects.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => !!p);
const title = 'Flooring Contractor in Berthoud, CO | Red Rock Remodeling';
const description =
  'Berthoud flooring contractor installing LVP, hardwood, tile, and stairs across Denver and Northern Colorado, subfloor work done right. Call Andrew for a bid.';

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: site.faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a }
  }))
};
---
<Layout title={title} description={description} canonicalPath="/">
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <section class="hero">
    <Photo
      class="hero-image"
      src={heroPhoto}
      alt="Herringbone luxury vinyl plank floor in a Berthoud living room with a stone fireplace"
      sizes="100vw"
      priority
    />
    <div class="hero-content container">
      <p class="eyebrow">Berthoud, Colorado · Front Range</p>
      <h1>Flooring Contractor in Berthoud, CO</h1>
      <p>
        Luxury vinyl plank, hardwood, tile, and stairs, installed by Andrew and Trevor Willenbring.
        30 years of floors across Denver and Northern Colorado, and the subfloor work done right
        before a single plank goes down.
      </p>
      <div class="button-row">
        <a class="button" href={site.phoneHref}>Call {site.phoneDisplay}</a>
        <a class="button-secondary" href={withBase('/portfolio/')}>See our work</a>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container">
      <p class="eyebrow">Services</p>
      <h2>Floors built for the way the room is used</h2>
      <p class="lead">
        LVP is what we do most. Hardwood is what we have done longest. Either way the job includes
        the tear-out, the subfloor, the transitions, and the base, not just the planks.
      </p>
      <div class="grid service-grid">
        {
          services.map((service) => (
            <ServiceCard
              title={service.data.title}
              description={service.data.shortDescription}
              href={`/services/${service.id}/`}
              image={service.data.cardImage}
              alt={service.data.cardAlt}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container two-column">
      <div>
        <p class="eyebrow">About Red Rock</p>
        <h2>Father and son. Thirty years of floors.</h2>
        <p>
          Red Rock Remodeling is Andrew Willenbring and his son Trevor. Andrew has installed floors
          across the Denver metro for 30 years; the shop is in Berthoud and the work runs from Fort
          Collins down to Castle Rock. Two people bid the job, and the same two people install it.
        </p>
        <p>
          That means a plain written bid, honest talk about materials, and the parts you do not see
          done properly: tear-out, leveling, vapor barrier, rotten subfloor cut out and replaced,
          base pulled and reinstalled. Licensed and insured.
        </p>
      </div>
      <Photo
        src={aboutPhoto}
        alt="Andrew Willenbring (left) and his son Trevor Willenbring (right), owners of Red Rock Remodeling, standing on a herringbone floor with the company logo"
        caption="Andrew (left) and Trevor Willenbring."
      />
    </div>
  </section>

  <section class="section section--white">
    <div class="container featured">
      <p class="eyebrow">Recent Jobs</p>
      <h2>What the work actually looks like</h2>
      {featured.map((p, i) => <ProjectStory project={p} compact reverse={i % 2 === 1} headingLevel="h3" />)}
      <p class="featured-more">
        <a class="button-secondary" href={withBase('/portfolio/')}>All jobs and photos</a>
      </p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container service-area">
      <div>
        <p class="eyebrow">Service Area</p>
        <h2>Fort Collins to Castle Rock, and all of Denver in between</h2>
        <p class="lead">
          Based in Berthoud. Thirty years of jobs across the Denver metro. Houses, condos, high-rises,
          basements, and mountain homes. Do not see your town below? Call and ask.
        </p>
      </div>
      <div class="area-panel" aria-label="Service area cities">
        <div class="range-line" aria-hidden="true">
          <span>Fort Collins</span>
          <span>Berthoud</span>
          <span>Denver</span>
          <span>Castle Rock</span>
        </div>
        <div class="area-links" aria-label="Location pages">
          {
            site.primaryAreaLinks.map((area) => (
              <a href={withBase(area.href)}>Flooring contractor in {area.city}</a>
            ))
          }
        </div>
        <ul>
          {site.serviceAreaCities.map((city) => <li>{city}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--white">
    <div class="container faq">
      <p class="eyebrow">Straight Answers</p>
      <h2>Questions people ask</h2>
      <dl>
        {
          site.faq.map((f) => (
            <div class="faq-item">
              <dt>{f.q}</dt>
              <dd>{f.a}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section contact-band">
    <div class="container contact-band-inner">
      <div>
        <p class="eyebrow">Ready To Talk Floors?</p>
        <h2>Get a measure and a written bid</h2>
        <p>
          Call or text Andrew with the room, the flooring you are thinking about, and what has to come
          out. He will set up a time to measure and give you a straight number.
        </p>
      </div>
      <div class="button-row">
        <a class="button" href={site.phoneHref}>{site.phoneDisplay}</a>
        <a class="button-secondary" href={withBase('/contact/')}>Contact page</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    position: relative;
    display: grid;
    min-height: min(76svh, 720px);
    padding: clamp(7rem, 14vw, 10rem) var(--space-4) var(--space-6);
    overflow: hidden;
    align-items: end;
    background: var(--color-ink);
  }

  .hero::after {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, rgb(34 32 29 / 0.9), rgb(34 32 29 / 0.42));
    content: '';
  }

  .hero :global(.hero-image) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border-radius: 0;
    aspect-ratio: auto;
  }
  .hero :global(.hero-image img) {
    object-position: center 70%;
  }

  .hero-content {
    position: relative;
    z-index: 1;
    color: var(--color-white);
  }

  .hero h1 {
    max-width: 780px;
    color: var(--color-white);
  }

  .hero p:not(.eyebrow) {
    max-width: 640px;
    color: rgb(255 255 255 / 0.88);
    font-size: var(--step-1);
  }

  .hero .button-secondary {
    border-color: var(--color-white);
    color: var(--color-white);
  }

  .hero .button-secondary:hover {
    border-color: var(--color-white);
    background: var(--color-white);
    color: var(--color-ink);
  }

  .service-grid {
    margin-top: var(--space-5);
  }

  .featured {
    display: grid;
    gap: var(--space-6);
  }
  .featured > .eyebrow {
    margin-bottom: 0;
  }
  .featured > h2 {
    margin-top: calc(-1 * var(--space-6) + var(--space-2));
  }
  .featured-more {
    margin: 0;
  }
  .faq dl {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    max-width: 820px;
  }
  .faq-item {
    padding: var(--space-3) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-paper);
  }
  .faq dt {
    margin-bottom: 0.3rem;
    font-weight: 800;
  }
  .faq dd {
    margin: 0;
    color: var(--color-muted);
  }

  .service-area {
    display: grid;
    gap: var(--space-5);
  }

  .area-panel {
    display: grid;
    gap: var(--space-4);
    padding: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-white);
  }

  .range-line {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-2);
    align-items: center;
  }

  .range-line span {
    position: relative;
    color: var(--color-ink);
    font-size: var(--step--1);
    font-weight: 900;
    text-align: center;
  }

  .range-line span::before {
    display: block;
    width: 14px;
    height: 14px;
    margin: 0 auto var(--space-1);
    border: 3px solid var(--color-red-rock);
    border-radius: 50%;
    background: var(--color-white);
    content: '';
  }

  .area-panel ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    padding: 0;
    list-style: none;
  }

  .area-links {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 210px), 1fr));
    gap: var(--space-2);
  }

  .area-links a {
    display: inline-flex;
    min-height: 44px;
    border: 1px solid rgb(168 40 34 / 0.3);
    border-radius: var(--radius);
    background: var(--color-paper);
    padding: 0.45rem 0.65rem;
    align-items: center;
    color: var(--color-red-rock);
    font-size: var(--step--1);
    font-weight: 800;
    text-decoration: none;
  }

  .area-links a:hover {
    border-color: var(--color-red-rock);
    background: var(--color-red-rock);
    color: var(--color-white);
  }

  .area-panel li {
    border: 1px solid var(--color-line);
    border-radius: var(--radius);
    background: var(--color-paper);
    padding: 0.25rem 0.55rem;
    color: var(--color-muted);
    font-size: var(--step--1);
    font-weight: 700;
  }

  .contact-band {
    background: var(--color-red-rock);
    color: var(--color-white);
  }

  .contact-band h2,
  .contact-band .eyebrow {
    color: var(--color-white);
  }

  .contact-band p {
    color: rgb(255 255 255 / 0.86);
  }

  .contact-band-inner {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    justify-content: space-between;
  }

  .contact-band .button {
    border-color: var(--color-white);
    background: var(--color-white);
    color: var(--color-red-rock);
  }

  .contact-band .button-secondary {
    border-color: var(--color-white);
    color: var(--color-white);
  }

  .contact-band .button-secondary:hover {
    background: var(--color-white);
    color: var(--color-red-rock);
  }
</style>
