---
import { getCollection } from 'astro:content';
import Layout from '@components/Layout.astro';
import Photo from '@components/Photo.astro';
import ProjectStory from '@components/ProjectStory.astro';
import { site, withBase } from '@data/site';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((service) => ({
    params: { slug: service.id },
    props: { service }
  }));
}

const { service } = Astro.props;
const data = service.data;
const allProjects = await getCollection('projects');
const related = data.relatedProjects
  .map((id) => allProjects.find((p) => p.id === id))
  .filter((p): p is NonNullable<typeof p> => !!p);
const hero = data.photos[0];
---

<Layout title={data.seoTitle} description={data.metaDescription} canonicalPath={`/services/${service.id}/`}>
  <article>
    <section class="section section--white service-hero">
      <div class="container two-column">
        <div>
          <p class="eyebrow">Flooring Service</p>
          <h1>{data.serviceName} Installation in Northern Colorado</h1>
          {data.lead.map((paragraph) => <p class="lead-copy">{paragraph}</p>)}
          <div class="button-row">
            <a class="button" href={site.phoneHref}>Call {site.phoneDisplay}</a>
            <a class="button-secondary" href={withBase('/contact/')}>Request a measure</a>
          </div>
        </div>
        <Photo src={hero.src} alt={hero.alt} aspect="4 / 5" priority />
      </div>
    </section>

    <section class="section section--soft">
      <div class="container detail-grid">
        <section class="surface detail-block">
          <h2>Material options</h2>
          <ul>
            {data.materialOptions.map((item) => <li>{item}</li>)}
          </ul>
        </section>
        <section class="surface detail-block">
          <h2>What is included</h2>
          <ul>
            {data.included.map((item) => <li>{item}</li>)}
          </ul>
        </section>
      </div>
    </section>

    <section class="section section--white">
      <div class="container">
        <p class="eyebrow">Recent Work</p>
        <h2>{data.title} photos from our jobs</h2>
        <div class="grid photo-grid">
          {data.photos.map((p) => <Photo src={p.src} alt={p.alt} caption={p.caption} aspect="4 / 3" />)}
        </div>
        {
          related.length > 0 && (
            <div class="related-projects">
              <h3>The full story on {related.length === 1 ? 'a recent job' : 'recent jobs'}</h3>
              {related.map((p, i) => (
                <ProjectStory project={p} compact reverse={i % 2 === 1} headingLevel="h3" />
              ))}
            </div>
          )
        }
      </div>
    </section>

    <section class="section section--soft">
      <div class="container two-column">
        <div>
          <p class="eyebrow">Project Info</p>
          <h2>What to expect</h2>
          {data.projectInfo.map((paragraph) => <p>{paragraph}</p>)}
        </div>
        <aside class="surface cta-box">
          <h2>Talk with Andrew</h2>
          <p>
            Share the room, current floor, and what you want installed. Red Rock can schedule
            a measure and bid from there.
          </p>
          <div class="button-row">
            <a class="button" href={site.phoneHref}>{site.phoneDisplay}</a>
            <a class="button-secondary" href={withBase('/contact/')}>Contact page</a>
          </div>
        </aside>
      </div>
    </section>
  </article>
</Layout>

<style>
  .related-projects {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }
  .related-projects > h3 {
    margin-bottom: calc(-1 * var(--space-3));
  }
  .service-hero {
    padding-bottom: var(--space-6);
  }

  .lead-copy {
    max-width: 740px;
    color: var(--color-muted);
    font-size: var(--step-1);
  }

  .detail-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: var(--space-4);
  }

  .detail-block,
  .cta-box {
    padding: var(--space-4);
  }

  .detail-block h2,
  .cta-box h2 {
    font-size: var(--step-3);
  }

  li + li {
    margin-top: 0.55rem;
  }

  .photo-grid {
    margin-top: var(--space-4);
  }
</style>
