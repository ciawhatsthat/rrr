---
import { getCollection } from 'astro:content';
import Layout from '@components/Layout.astro';
import ServiceCard from '@components/ServiceCard.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
import { site } from '@data/site';

const title = 'Flooring Services - LVP, Hardwood, Tile, Stairs | Red Rock Remodeling';
const description =
  'Flooring services from Red Rock Remodeling: luxury vinyl plank, hardwood, laminate, tile, stairs, rubber, and subfloor leveling across Denver and Northern CO.';
---

<Layout title={title} description={description} canonicalPath="/services/">
  <section class="section section--white page-hero">
    <div class="container">
      <p class="eyebrow">Services</p>
      <h1>Flooring Services</h1>
      <p class="lead">
        Andrew and Trevor install the floor and everything under it: tear-out, subfloor repair and
        leveling, vapor barrier, the floor itself, transitions, and base. Luxury vinyl plank is what
        we do most. Hardwood is what we have done longest.
      </p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <div class="grid">
        {
          services.map((service) => (
            <ServiceCard
              title={service.data.title}
              description={service.data.shortDescription}
              href={`/services/${service.id}/`}
              image={service.data.cardImage}
              alt={service.data.cardAlt}
            />
          ))
        }
      </div>
      <div class="related surface">
        <h2>Also on request</h2>
        <p>
          We install {site.alsoOnRequest.join(' and ').toLowerCase()} too, usually as part of a bigger job.
          We do not sand and refinish existing hardwood. If that is what you need, we will say so and point you
          the right way. First step for anything is a measure and a plain conversation about the room.
        </p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-bottom: var(--space-5);
  }

  .related {
    margin-top: var(--space-5);
    padding: var(--space-4);
  }

  .related h2 {
    font-size: var(--step-3);
  }

  .related p {
    max-width: 780px;
    margin-bottom: 0;
    color: var(--color-muted);
  }
</style>
