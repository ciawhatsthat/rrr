---
import Layout from '@components/Layout.astro';
import PortfolioGrid from '@components/PortfolioGrid.astro';
import { portfolioCategories, portfolioItems } from '@data/portfolio';

const title = 'Flooring Portfolio - Red Rock Remodeling';
const description =
  'View Red Rock Remodeling flooring portfolio work by category, including hardwood, LVP, tile, carpet, stairs, and before-after projects in Northern Colorado.';
---

<Layout title={title} description={description} canonicalPath="/portfolio/">
  <section class="section section--white page-hero">
    <div class="container">
      <p class="eyebrow">Portfolio</p>
      <h1>Flooring Portfolio</h1>
      <p class="lead">
        Browse flooring work by category: hardwood, LVP, tile, carpet, stairs, and before-after
        repairs. Every job here was installed by Red Rock in a Front Range home.
      </p>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container">
      <PortfolioGrid items={portfolioItems} categories={portfolioCategories} />
    </div>
  </section>
</Layout>

<style>
  .page-hero {
    padding-bottom: var(--space-5);
  }
</style>
